{
  "name": "pacey",
  "version": "1.0.0",
  "private": true,
  "description": "Pacey: pace your drinking during one night out",
  "bin": {
    "pacey": "bin/pacey.js"
  },
  "scripts": {
    "start": "node bin/pacey.js",
    "dev": "node bin/pacey.js --dev",
    "demo": "node bin/pacey.js --demo",
    "web": "node web/build.js",
    "web:serve": "node web/build.js && node web/serve.js"
  }
}
